# Environment
ENVIRONMENT=production

# Prometheus
PROMETHEUS_URL=http://prometheus:9090

# Redis (Docker service names)
REDIS_US_HOST=redis-us
REDIS_US_PORT=6379
REDIS_EU_HOST=redis-eu
REDIS_EU_PORT=6380
REDIS_ASIA_HOST=redis-asia
REDIS_ASIA_PORT=6381

# Gateways
GATEWAY_US_URL=http://gateway-us:8080
GATEWAY_EU_URL=http://gateway-eu:8080
GATEWAY_ASIA_URL=http://gateway-asia:8080

# API
API_HOST=0.0.0.0
API_PORT=5001
CORS_ORIGINS=*

# Dashboard
DASHBOARD_API_URL=http://api:5001

# Paths (container paths)
SIMULATOR_PATH=/app/simulator/main.py
AGENT_PATH=/app/agent/main.py
SEED_POLICIES_PATH=/app/tools/seed_policies.py
